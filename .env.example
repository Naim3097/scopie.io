# ── Scopie environment ─────────────────────────────────────────────
# Copy to .env (api/worker) and apps/web/.env.local (web). Never commit real values.

# Core
NODE_ENV=development
API_PORT=4000
# Public URL of the API — REQUIRED whenever real payment credentials are set:
# the gateway posts webhooks here. Never leave at localhost in production.
API_PUBLIC_URL=http://localhost:4000

# Web → API base (public)
NEXT_PUBLIC_API_URL=http://localhost:4000
# MCP server → API base
SCOPIE_API_URL=http://localhost:4000

# Supabase (Singapore project) — auth, Postgres, realtime, storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres (direct connection for api/worker; Supabase connection string works)
DATABASE_URL=postgres://scopie:scopie@localhost:5432/scopie

# Redis (BullMQ queues, counters, timeline cache)
REDIS_URL=redis://localhost:6379

# Meilisearch (hybrid product + video search)
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=

# LiveKit (live rooms: seller streams + AI host channel)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# Payments — LeanX (server-side ONLY; the provider brand must never reach the client)
# Sandbox: https://api.leanx.dev · Production: https://api.leanx.io
# Credentials come from the merchant portal (portal.leanx.io → API page).
LEANX_BASE_URL=https://api.leanx.dev
LEANX_AUTH_TOKEN=
LEANX_MERCHANT_UUID=
LEANX_HASH_KEY=
LEANX_COLLECTION_UUID=
LEANX_PAYOUT_POOL_REF=

# Media (Cloudflare Stream for VOD/live delivery)
CF_ACCOUNT_ID=
CF_STREAM_TOKEN=

# AI providers
ANTHROPIC_API_KEY=
HEYGEN_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# Commerce (Medusa/Mercur backend)
MEDUSA_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=
