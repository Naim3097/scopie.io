{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    /* DOM lib pins the fetch/Response/Headers globals to a full definition —
       some CI environments resolve @types/node's undici globals differently
       than local installs (seen on Vercel), and this makes the compile
       environment-independent. */
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src"]
}
